/*
 * 阅读提示：Windows 菜单与图标资源定义，资源编译器把它们嵌入可执行文件。
 * 先看资源编号，再查找使用这些编号的窗口命令处理。
 */
// 由资源编辑器生成的 Windows 资源脚本。
#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
// 由资源编辑器中的第二段文本包含设置生成。
#include "winres.h"

/////////////////////////////////////////////////////////////////////////////
#undef APSTUDIO_READONLY_SYMBOLS

// 资源语言设置为英国英语；这是资源标记，不影响中文源码注释。

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENG)
#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_UK
#pragma code_page(1252)
#endif // Windows 资源：菜单定义。

IDR_MENU1 MENU DISCARDABLE 
BEGIN
    POPUP "Debug Aids"
    BEGIN
        MENUITEM "No Aids",                     ID_AIDS_NOAIDS
        MENUITEM "Show IDs",                    IDM_SHOW_IDS
        MENUITEM "Show States",                 IDM_SHOW_STATES
        MENUITEM "Show Regions",                IDM_SHOW_REGIONS
        MENUITEM "Show Support Spots",          IDM_AIDS_SUPPORTSPOTS
        MENUITEM "Show Targets",                ID_AIDS_SHOWTARGETS
        MENUITEM "Highlight if Threatened",     IDM_AIDS_HIGHLITE
    END
END


#ifdef APSTUDIO_INVOKED
// 资源编辑器使用的文本包含信息。

1 TEXTINCLUDE DISCARDABLE 
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE DISCARDABLE 
BEGIN
    "#include ""afxres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE DISCARDABLE 
BEGIN
    "\r\n"
    "\0"
END

#endif    // 图标资源：优先放置编号最小的图标，确保不同系统采用一致的应用图标。
IDI_ICON1               ICON    DISCARDABLE     "icon1.ico"
#endif    // 英国英语资源段结束。



#ifndef APSTUDIO_INVOKED
// 由资源编辑器中的第三段文本包含设置生成。
#endif    // 结束非资源编辑器构建条件。

